# PocketBase URL the frontend talks to during development.
# In production the app is served by PocketBase itself, so it uses the page origin.
VITE_POCKETBASE_URL=https://daythatworks.com

# OAuth credentials — only needed for a LOCAL `pocketbase serve`. On PocketHost,
# set these in the dashboard (instance → Secrets) instead; never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dev-only fake OAuth (local development only, NEVER on PocketHost).
# Set VITE_DEV_AUTH=true to show the "Dev login" button, and export
# DEV_AUTH=true DEV_AUTH_NAME="Dev User" DEV_AUTH_EMAIL=dev@local.test
# in the environment of your local `pocketbase serve` process to enable
# the /api/dev-login route it talks to.
VITE_DEV_AUTH=

